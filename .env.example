# ============================================================
# BANCO DE DADOS
# ------------------------------------------------------------
# Dev (padrão): SQLite — funciona sem instalar nada.
# Produção: PostgreSQL — troque a URL abaixo E o provider em
#   prisma/schema.prisma de "sqlite" para "postgresql".
# ============================================================
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/ecommerce?schema=public"

# ============================================================
# APLICAÇÃO / AUTENTICAÇÃO (NextAuth)
# ------------------------------------------------------------
# NEXTAUTH_SECRET: gere um valor forte com:  openssl rand -base64 32
# Em produção, NEXTAUTH_URL e NEXT_PUBLIC_APP_URL devem usar HTTPS.
# ============================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="troque-por-um-segredo-forte"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Nº de proxies reversos confiáveis na frente da app (Caddy/Nginx = 1).
# Usado pelo rate-limit para ler o IP REAL do visitante (à direita do
# X-Forwarded-For) e não um valor falsificável. Deixe 1 em produção.
TRUSTED_PROXY_HOPS="1"

# Duração máxima da sessão de ADMIN (horas) desde o login. Depois disso,
# o painel exige novo login — limita a exposição do "cockpit". Padrão 8.
# Não afeta a sessão dos clientes da loja.
ADMIN_SESSION_MAX_HOURS="8"

# Login social Google (opcional — deixe vazio para desativar)
# Crie credenciais em https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================================
# MERCADO PAGO
# ------------------------------------------------------------
# Credenciais em: https://www.mercadopago.com.br/developers/panel/app
#   SANDBOX  -> use as "Credenciais de teste"  (TEST-...)
#   PRODUÇÃO -> use as "Credenciais de produção" (APP_USR-...)
# MERCADOPAGO_WEBHOOK_SECRET: "Assinatura secreta" gerada ao
# configurar o webhook no painel do Mercado Pago.
# ============================================================
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# ============================================================
# FRETE — MELHOR ENVIO (recomendado; agregador, sem contrato próprio)
# ------------------------------------------------------------
# Token em: https://melhorenvio.com.br -> Painel -> Integrações -> Tokens
# Conta gratuita; cotação não gera custo (paga só por etiqueta emitida).
# Cobre Correios (PAC/SEDEX), Jadlog, Loggi e outras num só lugar.
# MELHOR_ENVIO_AMBIENTE: "producao" (preços reais) ou "sandbox" (testes)
# Com o token preenchido, o Melhor Envio é usado automaticamente.
# ============================================================
# Client ID + Secret do app criado em: Painel -> Área Dev. -> Cadastrar aplicativo.
# O sistema gera e renova o token automaticamente (OAuth client_credentials).
# ATENÇÃO: client_credentials serve APENAS para COTAÇÃO (calcular frete).
MELHOR_ENVIO_CLIENT_ID=""
MELHOR_ENVIO_CLIENT_SECRET=""
# MELHOR_ENVIO_TOKEN: token PESSOAL da conta (Painel -> Integrações -> Tokens),
# OBRIGATÓRIO para GERAR ETIQUETA. Gere com os escopos:
#   shipping-calculate shipping-cart shipping-checkout
#   shipping-generate  shipping-print shipping-tracking
# Quando preenchido, este token é usado tanto na cotação quanto na etiqueta.
# A emissão paga com o SALDO da conta Melhor Envio (mantenha saldo/carteira).
MELHOR_ENVIO_TOKEN=""
MELHOR_ENVIO_AMBIENTE="producao"
MELHOR_ENVIO_FROM_CEP="01001000"
MELHOR_ENVIO_USER_AGENT="Minha Loja (contato@minhaloja.com.br)"
# Transportadoras exibidas no checkout (vazio = todas). Ex.: "Correios,Jadlog"
MELHOR_ENVIO_TRANSPORTADORAS=""
# --- Endereço de ORIGEM (remetente) — obrigatório para gerar etiqueta ---
# Precisa bater com um endereço válido da conta. CEP já vem de FROM_CEP acima.
MELHOR_ENVIO_FROM_NAME=""          # nome do remetente (loja ou responsável)
MELHOR_ENVIO_FROM_DOCUMENT=""      # CNPJ ou CPF do remetente (só dígitos)
MELHOR_ENVIO_FROM_PHONE=""         # telefone com DDD (só dígitos)
MELHOR_ENVIO_FROM_EMAIL=""         # e-mail do remetente
MELHOR_ENVIO_FROM_ADDRESS=""       # logradouro (rua/av.)
MELHOR_ENVIO_FROM_NUMBER=""        # número
MELHOR_ENVIO_FROM_COMPLEMENT=""    # complemento (opcional)
MELHOR_ENVIO_FROM_DISTRICT=""      # bairro
MELHOR_ENVIO_FROM_CITY=""          # cidade
MELHOR_ENVIO_FROM_STATE=""         # UF (2 letras). Ex.: RS

# ============================================================
# RETIRADA NA LOJA (opção de retirar no local, frete grátis)
# ============================================================
STORE_PICKUP_ENABLED="false"
STORE_PICKUP_LABEL="Retirar na loja"
STORE_PICKUP_DAYS="1"
STORE_PICKUP_ADDRESS=""

# ============================================================
# CORREIOS (API CWS — exige contrato com os Correios)
# ------------------------------------------------------------
# Alternativa ao Melhor Envio, para quem tem contrato próprio.
# Credenciais em: https://cws.correios.com.br (Meu Perfil > Gestão de APIs)
# Sem NENHUM provider configurado (Melhor Envio ou Correios), o sistema
# usa automaticamente a tabela de frete interna (ShippingRule) do admin.
# Ordem de preferência: Melhor Envio > Correios > tabela interna.
# CORREIOS_AMBIENTE: "producao" ou "homologacao"
# ============================================================
CORREIOS_AMBIENTE="homologacao"
CORREIOS_USUARIO=""
CORREIOS_CODIGO_ACESSO=""
CORREIOS_CONTRATO=""
CORREIOS_CEP_ORIGEM="01001000"

# ============================================================
# E-MAIL (SMTP) — recomendado: BREVO (plano grátis: 300 e-mails/dia)
# ------------------------------------------------------------
# Sem SMTP_HOST, os e-mails só são registrados no console (modo dev).
#
# BREVO (ex-Sendinblue): crie a conta em https://www.brevo.com →
#   Transactional → SMTP & API → "SMTP". Use:
#     SMTP_HOST = smtp-relay.brevo.com
#     SMTP_PORT = 587
#     SMTP_USER = o login/e-mail que o Brevo mostra na tela de SMTP
#     SMTP_PASS = a "SMTP key" (Master Password) gerada ali (NÃO a senha do painel)
#   SMTP_FROM deve usar um REMETENTE VERIFICADO no Brevo (Senders/Domains).
#   Para cair na caixa de entrada, configure SPF e DKIM no DNS do domínio
#   (o Brevo fornece os registros). Veja DEPLOY.md.
#
# Teste depois de preencher:  npm run email:test -- voce@email.com
# ============================================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Gata Fit <contato@usegatafit.com.br>"

# ============================================================
# DADOS DA LOJA (rodapé, páginas legais, WhatsApp)
# ------------------------------------------------------------
# STORE_WHATSAPP: só dígitos com DDI. Ex.: 5551999999999
# ============================================================
STORE_LEGAL_NAME=""
STORE_CNPJ=""
STORE_LEGAL_ADDRESS=""
STORE_CONTACT_EMAIL=""
STORE_WHATSAPP=""

# ============================================================
# WHATSAPP — NOTIFICAÇÕES AUTOMÁTICAS (opcional)
# ------------------------------------------------------------
# Envia "Pedido enviado" e "Pedido entregue" pelo WhatsApp do cliente.
# Agnóstico de provedor: qualquer API REST que aceite POST {phone, message}
# com token Bearer (Z-API, Evolution API, UltraMsg, Cloud API via proxy...).
# Sem WHATSAPP_API_URL, o envio fica DESLIGADO (só registra no console).
# NÃO confundir com o botão flutuante wa.me (link de conversa), que é à parte.
# ============================================================
WHATSAPP_API_URL=""            # endpoint POST do provedor
WHATSAPP_API_TOKEN=""          # token/credencial (enviado como Bearer)
WHATSAPP_PHONE_FIELD="phone"   # nome do campo do telefone no corpo (padrão)
WHATSAPP_TEXT_FIELD="message"  # nome do campo do texto no corpo (padrão)
WHATSAPP_DDI="55"              # DDI padrão p/ números sem código de país

# ============================================================
# CRON — SINCRONIZAÇÃO DE RASTREIO (opcional, recomendado)
# ------------------------------------------------------------
# Protege o endpoint GET /api/cron/tracking, que consulta o Melhor Envio
# e marca pedidos como ENTREGUE automaticamente. Sem CRON_SECRET o
# endpoint fica DESLIGADO (responde 401). Gere um valor forte:
#   openssl rand -base64 32
# Agende no VPS (ex.: de 3 em 3h):
#   0 */3 * * * curl -s -H "Authorization: Bearer SEU_CRON_SECRET" \
#     https://SEU-DOMINIO/api/cron/tracking
# ============================================================
CRON_SECRET=""

# Expiração de pedidos não pagos (libera o estoque de checkouts abandonados).
# O estoque é reservado na criação do pedido; sem isso, pedidos que o cliente
# nunca pagou seguram estoque para sempre. DESLIGADO se vazio/0.
# ⚠️ Se aceitar BOLETO, use um valor MAIOR que o prazo do boleto (ex.: 96)
# para não cancelar boletos ainda pagáveis. Cron: /api/cron/expire-orders
ORDER_EXPIRY_HOURS=""

# ============================================================
# MONITORAMENTO DE ERROS (Sentry — opcional)
# ------------------------------------------------------------
# Sem SENTRY_DSN, o monitoramento fica DESLIGADO (no-op).
# O DSN é de SERVIDOR (não vai para o bundle do cliente).
# Crie um projeto em https://sentry.io e cole o DSN aqui —
# de preferência no painel do serviço de hospedagem, não no repo.
# ============================================================
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# ============================================================
# TRÁFEGO PAGO / RASTREAMENTO (Meta Pixel + GA4 — opcional)
# ------------------------------------------------------------
# Sem esses valores, o rastreamento fica DESLIGADO. O rastreio no
# navegador só dispara após o visitante aceitar os cookies (LGPD).
#
# IDs PÚBLICOS (vão para o navegador, como o pixel de qualquer site):
NEXT_PUBLIC_META_PIXEL_ID=""     # ID do Pixel (Meta > Gerenciador de Eventos)
NEXT_PUBLIC_GA4_ID=""            # ID do Google Analytics 4 (formato G-XXXXXXX)
#
# SEGREDO (só servidor, SEM NEXT_PUBLIC) — token da API de Conversões:
# usado para mandar o evento de COMPRA server-side (Meta > Conversões).
META_CAPI_ACCESS_TOKEN=""
#
# Feed do catálogo (cadastrar no Gerenciador de Catálogo da Meta / Google
# Merchant Center):  https://SEU-DOMINIO/feed/produtos.xml
# ============================================================
